{
    "title": "Amazon Fargate Overview",
    "description": "## Amazon Fargate\n\nThis dashboard displays key metrics from your Amazon ECS cluster on AWS Fargate, such as cpu, memory, IO usage, network and Ephemeral Storage\n\nFurther reading on ECS-Fargate:\n\n- [Datadog ECS-Fargate integration docs](https://docs.datadoghq.com/integrations/ecs_fargate/)\n- [Integration setup docs](https://docs.datadoghq.com/integrations/faq/integration-setup-ecs-fargate/?tab=rediswebui)\n",
    "widgets": [
        {
            "definition": {
                "title": "Containers",
                "title_size": "16",
                "title_align": "left",
                "type": "list_stream",
                "requests": [
                    {
                        "request_type": "infrastructure_list",
                        "query": {
                            "data_source": "infrastructure",
                            "resource_type": "container",
                            "query_string": "cluster_name:$ecs_cluster.value task_family:$task_family.value container_name:$container_name.value"
                        },
                        "columns": []
                    }
                ]
            },
            "layout": {
                "x": 0,
                "y": 0,
                "width": 12,
                "height": 4
            },
            "id": 9000000000001
        },
        {
            "definition": {
                "type": "timeseries",
                "requests": [
                    {
                        "q": "top(avg:ecs.fargate.cpu.user{$scope,$ecs_cluster,$task_family,$container_name} by {container_id}, 10, 'mean', 'desc')",
                        "display_type": "line",
                        "style": {
                            "palette": "dog_classic",
                            "line_type": "solid",
                            "line_width": "normal"
                        }
