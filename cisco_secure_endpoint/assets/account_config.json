{
  "supported_auth_methods": [
    {
      "auth_name": "Client ID and API key",
      "basic": {
        "user_setting": {
          "key": "client_id",
          "label": "Client ID",
          "editable": true,
          "required": true,
          "text": {}
        },
        "password_setting": {
          "key": "api_key",
          "label": "API key",
          "editable": true,
          "required": true,
          "password": {}
        }
      }
    }
  ],
  "supported_connection_methods": [
    {
      "name": "Cisco Secure Endpoint API",
      "multitenant": {
        "tenant_setting": {
          "key": "api_domain_name",
          "label": "API domain name",
          "help": "The domain of your Cisco Secure Endpoint API, without a scheme or path. Cloud regions: api.amp.cisco.com (North America), api.eu.amp.cisco.com (Europe), api.apjc.amp.cisco.com (Asia Pacific, Japan, and China).",
          "editable": true,
          "required": true,
          "text": {
            "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+(:[0-9]{1,5})?$"
          }
        },
        "base_url_format": "https://%s"
      }
    }
  ],
  "additional_config_fields": [
    {
      "key": "get_endpoint_details",
      "label": "Collect endpoint metadata for Cisco Secure Endpoint event logs",
      "editable": true,
      "required": false,
      "checkbox": {
        "default": true
      }
    }
  ],
  "dataflow_config": [
    { "dataflow_id": "cisco-secure-endpoint-logs" }
  ]
}
