          {
            "id": 6728683731458200,
            "definition": {
              "title": "Log Count by Source \"source:abnormal-security\"",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": ["avg", "min", "max", "value", "sum"],
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [{ "formula": "query1" }],
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "logs",
                      "search": { "query": "source:abnormal-security " },
                      "indexes": ["*"],
                      "group_by": [
                        {
                          "facet": "source",
                          "limit": 10,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc",
                            "metric": "count"
