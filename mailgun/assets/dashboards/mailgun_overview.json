                    {
                        "id": 2112314635984052,
                        "definition": {
                            "title": "Previous Day Email Change",
                            "title_size": "16",
                            "title_align": "left",
                            "time": {
                                "live_span": "1d"
                            },
                            "type": "change",
                            "requests": [
                                {
                                    "formulas": [
                                        {
                                            "formula": "day_before(query1)"
                                        },
                                        {
                                            "formula": "query1"
                                        }
                                    ],
                                    "order_by": "change",
                                    "order_dir": "desc",
                                    "compare_to": "hour_before",
                                    "response_format": "scalar",
                                    "show_present": true,
                                    "increase_good": true,
                                    "queries": [
                                        {
                                            "query": "avg:mailgun.emails.delivered.total{*}",
                                            "data_source": "metrics",
                                            "name": "query1",
                                            "aggregator": "avg"
