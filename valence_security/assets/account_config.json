{
  "supported_auth_methods": [
    {
      "auth_name": "API key",
      "bearer_token": {
        "password_setting": {
          "key": "api_key",
          "label": "API key",
          "help": "Valence Security API key, generated under Administration > Settings > Valence API.",
          "editable": true,
          "required": true,
          "password": {}
        }
      }
    }
  ],
  "supported_connection_methods": [
    {
      "name": "Valence Security API",
      "regional": {
        "region_setting": {
          "key": "region",
          "label": "Region",
          "help": "Your Valence Security region: US for app.valencesecurity.com, EU for appeu.valencesecurity.com.",
          "editable": true,
          "required": true,
          "dropdown": {
            "options": [
              { "value": "us", "label": "US" },
              { "value": "eu", "label": "EU" }
            ]
          }
        },
        "region_base_urls": {
          "us": "https://app.valencesecurity.com",
          "eu": "https://appeu.valencesecurity.com"
        }
      }
    }
  ],
  "additional_config_fields": [
    {
      "key": "collect_alerts",
      "label": "Collect Alerts",
      "editable": true,
      "required": false,
      "checkbox": {
        "default": true
      }
    },
    {
      "key": "collect_audit_logs",
      "label": "Collect Audit Logs",
      "editable": true,
      "required": false,
      "checkbox": {
        "default": true
      }
    }
  ],
  "dataflow_config": [
    { "dataflow_id": "valence-security-logs" }
  ],
  "health_probe": {
    "http_method": "GET",
    "path": "/api/v2/alerts/alertTypes"
  }
}
