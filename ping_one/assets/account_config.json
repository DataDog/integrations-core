      "key": "domain",
      "label": "Domain",
      "editable": true,
      "required": true,
      "dropdown": {
        "options": [
          { "value": "ca", "label": "ca" },
          { "value": "com", "label": "com" },
          { "value": "com.au", "label": "com.au" },
          { "value": "eu", "label": "eu" },
          { "value": "asia", "label": "asia" }
        ]
      }
    },
    {
      "key": "env_id",
      "label": "Environment ID",
      "editable": true,
      "required": true,
      "text": {
        "pattern": "[\\w\\-]*"
      }
    }
  ],
  "dataflow_config": [
    { "dataflow_id": "ping-one-logs" }
  ]
