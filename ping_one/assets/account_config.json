{
  "supported_auth_methods": [
    {
      "auth_name": "Client ID and secret",
      "basic": {
        "user_setting": {
          "key": "client_id",
          "label": "Client ID",
          "editable": true,
          "required": true,
          "text": {}
        },
        "password_setting": {
          "key": "client_secret",
          "label": "Client secret",
          "editable": true,
          "required": true,
          "password": {}
        }
      }
    }
