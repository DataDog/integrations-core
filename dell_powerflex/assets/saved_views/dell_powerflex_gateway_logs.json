{
  "name": "Dell Powerflex gateway logs",
  "type": "logs",
  "page": "stream",
  "query": "source:dell-powerflex @logger.name:*",
  "timerange": {
    "interval_ms": 900000
  },
  "options": {
    "columns": [
      "host",
      "status",
      "@logger.name",
      "@logger.thread_name"
    ],
    "show_date_column": true,
    "show_message_column": true,
    "message_display": "inline",
    "show_timeline": true
  }
}
