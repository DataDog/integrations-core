## All options defined here are available to all instances.
#
init_config:

    ## @param service - string - optional
    ## Attach the tag `service:<SERVICE>` to every metric, event, and service check emitted by this integration.
    ##
    ## Additionally, this sets the default `service` for every log source.
    #
    # service: <SERVICE>

## Every instance is scheduled independently of the others.
#
instances:

  -
    ## @param cluster_name - string - optional
    ## Override the cluster name reported in the `powerha_cluster` tag. By default the check
    ## discovers this by querying the `HACMPcluster` ODM object with `odmget`.
    #
    # cluster_name: prodcluster

    ## @param utilities_path - string - optional
    ## Directory containing the PowerHA cluster utilities (`clRGinfo`, `clfindres`).
    #
    # utilities_path: <UTILITIES_PATH>

    ## @param clras_path - string - optional
    ## Path to the `clras` CAA diagnostics binary, used to check SAN-based and disk-based
    ## cluster communication paths.
    #
    # clras_path: <CLRAS_PATH>

    ## @param hacmp_out_path - string - optional
    ## Override the path to the `hacmp.out` cluster event log. By default the check resolves this
    ## from the `HACMPlogs` ODM object. The `dd-agent` user must have read permission on this file
    ## for `collect_cluster_events` to work.
    #
    # hacmp_out_path: /var/hacmp/log/hacmp.out

    ## @param collect_resource_groups - boolean - optional - default: true
    ## Collect resource group placement and state via `clRGinfo -s` (falling back to the legacy
    ## `clfindres -s` if unavailable).
    #
    # collect_resource_groups: true

    ## @param collect_app_monitor_status - boolean - optional - default: false
    ## Collect application monitor status via `clRGinfo -m`. Disabled by default since it requires
    ## an additional command invocation and application monitors are not configured on every cluster.
    #
    # collect_app_monitor_status: false

    ## @param collect_caa_comms - boolean - optional - default: true
    ## Collect Cluster Aware AIX (CAA) topology and communication path health via `lscluster -m`
    ## and `clras sancomm_status`/`clras dpcomm_status`.
    #
    # collect_caa_comms: true

    ## @param collect_network_interfaces - boolean - optional - default: true
    ## Collect PowerHA-monitored network interface status via `netstat -i`.
    #
    # collect_network_interfaces: true

    ## @param collect_network_interface_counters - boolean - optional - default: false
    ## Also submit packet/error/collision counters for each network interface. Disabled by default
    ## to avoid duplicating metrics already collected by the `network` check.
    #
    # collect_network_interface_counters: false

    ## @param submit_ip_address_tag - boolean - optional - default: false
    ## Tag network interface metrics with the interface's current IP address. Disabled by default
    ## because IP addresses can move between interfaces during a takeover, which would churn tags.
    #
    # submit_ip_address_tag: false

    ## @param collect_volume_groups - boolean - optional - default: true
    ## Collect shared volume group and physical volume status via `lsvg -o` and `lsvg -p`.
    #
    # collect_volume_groups: true

    ## @param exclude_volume_groups - list of strings - optional
    ## Volume groups to exclude from collection, for example private/non-shared volume groups.
    #
    # exclude_volume_groups: []

    ## @param collect_cluster_events - boolean - optional - default: true
    ## When the cluster manager is not in a stable state, look up the most recent event from the
    ## `hacmp.out` log and include it in the `powerha.cluster_manager.status` service check message.
    #
    # collect_cluster_events: true

    ## @param tags - list of strings - optional
    ## A list of tags to attach to every metric and service check emitted by this instance.
    ##
    ## Learn more about tagging at https://docs.datadoghq.com/tagging
    #
    # tags:
    #   - <KEY_1>:<VALUE_1>
    #   - <KEY_2>:<VALUE_2>

    ## @param service - string - optional
    ## Attach the tag `service:<SERVICE>` to every metric, event, and service check emitted by this integration.
    ##
    ## Overrides any `service` defined in the `init_config` section.
    #
    # service: <SERVICE>

    ## @param min_collection_interval - number - optional - default: 15
    ## This changes the collection interval of the check. For more information, see:
    ## https://docs.datadoghq.com/developers/write_agent_check/#collection-interval
    #
    # min_collection_interval: 15

    ## @param empty_default_hostname - boolean - optional - default: false
    ## This forces the check to send metrics with no hostname.
    ##
    ## This is useful for cluster-level checks.
    #
    # empty_default_hostname: false

    ## @param metric_patterns - mapping - optional
    ## A mapping of metrics to include or exclude, with each entry being a regular expression.
    ##
    ## Metrics defined in `exclude` will take precedence in case of overlap.
    #
    # metric_patterns:
    #   include:
    #   - <INCLUDE_REGEX>
    #   exclude:
    #   - <EXCLUDE_REGEX>
