{
    "title": "Lambda MicroVM Monitoring",
    "description": "Monitoring dashboard for AWS Lambda MicroVM resources. Filter by AWS account, region, resource type, image, and environment. The Global View includes all values.",
    "widgets":
    [
        {
            "id": 1000001,
            "definition":
            {
                "title": "MicroVM Overview",
                "background_color": "vivid_blue",
                "show_title": true,
                "type": "group",
                "layout_type": "ordered",
                "widgets":
                [
                    {
                        "id": 2291884193248645,
                        "definition":
                        {
                            "title": "Active MicroVM Instances (at selected end)",
                            "title_size": "16",
                            "title_align": "left",
                            "description": "Distinct MicroVM instances with a heartbeat in the 1 minute ending at the dashboard selected end time. Applies the image, region, and environment filters. Shows 0 when no matching heartbeat is present. This is a recent-heartbeat estimate, not an exact lifecycle inventory.",
                            "time":
                            {
                                "live_span": "1m"
                            },
                            "type": "query_value",
                            "requests":
                            [
                                {
                                    "formulas":
                                    [
                                        {
                                            "formula": "default_zero(count_nonzero(query1))"
                                        }
                                    ],
                                    "queries":
                                    [
                                        {
                                            "aggregator": "last",
                                            "data_source": "metrics",
                                            "name": "query1",
                                            "query": "avg:aws.lambda.microvm.enhanced.active_instances{$env,$image_name,$region,!lambda_microvm_id:unknown,$account_id,$resource_type} by {lambda_microvm_id}"
                                        }
                                    ],
                                    "response_format": "scalar"
                                }
                            ],
                            "autoscale": true,
                            "precision": 0,
                            "timeseries_background":
                            {
                                "type": "area"
                            }
                        },
                        "layout":
                        {
                            "x": 0,
                            "y": 0,
                            "width": 4,
                            "height": 3
                        }
                    },
