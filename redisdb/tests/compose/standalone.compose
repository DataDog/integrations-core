services:
  redis-standalone:
    image: "redis:${REDIS_VERSION:-7.0}"
    volumes:
      - ${REDIS_CONFIG:-../config/auth.conf}:/etc/redis.conf
    ports:
      - "6379:6379"
    networks:
      - network1
    command: redis-server /etc/redis.conf

networks:
  network1:
    name: standalone_default
