{
  "name": "Automox API key created without an expiry",
  "product": [
    "security_monitoring"
  ],
  "defaultRuleId": "def-000-ane",
  "tags": [
    "source:automox",
    "security:attack",
    "tactic:TA0003-persistence",
    "technique:T1098-account-manipulation",
    "subtechnique:T1098.001-additional-cloud-credentials",
    "mitre_platform:cloud",
    "mitre_platform:saas"
  ],
  "isEnabled": true,
  "isShadowDeployed": true,
  "isBeta": true,
  "options": {
    "detectionMethod": "threshold",
    "evaluationWindow": 900,
    "keepAlive": 3600,
    "maxSignalDuration": 86400
  },
  "queries": [
    {
      "name": "automox_api_key_no_expiry",
      "query": "source:automox @ocsf.class_uid:3004 @ocsf.message:\"API Key Created\" @ocsf.entity.type:\"API Key\" -@ocsf.entity.data.expires_at:*",
      "groupByFields": [
        "@ocsf.entity.uid"
      ],
      "distinctFields": [],
      "aggregation": "count"
    }
  ],
  "cases": [
    {
      "name": "",
      "status": "Low",
      "notifications": [],
      "condition": "automox_api_key_no_expiry > 0"
    }
  ]
}
