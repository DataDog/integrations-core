{
  "name": "Automox remote-control streamer installed on every device",
  "product": [
    "security_monitoring"
  ],
  "defaultRuleId": "def-000-rsi",
  "tags": [
    "source:automox",
    "security:attack",
    "tactic:TA0011-command-and-control",
    "technique:T1219-remote-access-tools",
    "mitre_platform:windows",
    "mitre_platform:macos",
    "mitre_platform:linux"
  ],
  "isEnabled": true,
  "isShadowDeployed": true,
  "isBeta": true,
  "options": {
    "detectionMethod": "threshold",
    "evaluationWindow": 900,
    "keepAlive": 3600,
    "maxSignalDuration": 86400
  },
  "queries": [
    {
      "name": "automox_streamer_install_org_wide",
      "query": "source:automox @ocsf.class_uid:6001 @ocsf.message:\"Org-Wide Splashtop Streamer Install Initiated\"",
      "groupByFields": [
        "@ocsf.web_resources.uid"
      ],
      "distinctFields": [],
      "aggregation": "count"
    }
  ],
  "cases": [
    {
      "name": "",
      "status": "High",
      "notifications": [],
      "condition": "automox_streamer_install_org_wide > 0"
    }
  ]
}
