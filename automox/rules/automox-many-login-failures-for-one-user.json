{
  "name": "Automox many login failures for one user",
  "product": [
    "security_monitoring"
  ],
  "defaultRuleId": "def-000-mlf",
  "tags": [
    "source:automox",
    "security:attack",
    "tactic:TA0006-credential-access",
    "technique:T1110-brute-force",
    "mitre_platform:cloud",
    "mitre_platform:saas"
  ],
  "isEnabled": true,
  "isShadowDeployed": true,
  "isBeta": true,
  "options": {
    "detectionMethod": "threshold",
    "evaluationWindow": 900,
    "keepAlive": 3600,
    "maxSignalDuration": 86400
  },
  "queries": [
    {
      "name": "automox_login_failures",
      "query": "source:automox @ocsf.class_uid:3002 @ocsf.message:\"User Log In Failure\"",
      "groupByFields": [
        "@ocsf.user.email_addr"
      ],
      "distinctFields": [],
      "aggregation": "count"
    }
  ],
  "cases": [
    {
      "name": "",
      "status": "Low",
      "notifications": [],
      "condition": "automox_login_failures >= 10"
    }
  ]
}
