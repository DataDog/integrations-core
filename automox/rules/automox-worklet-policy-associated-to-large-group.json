{
  "name": "Automox worklet policy associated to a large device group",
  "product": [
    "security_monitoring"
  ],
  "defaultRuleId": "def-000-wag",
  "tags": [
    "source:automox",
    "security:attack",
    "tactic:TA0002-execution",
    "technique:T1072-software-deployment-tools",
    "mitre_platform:windows",
    "mitre_platform:macos",
    "mitre_platform:linux"
  ],
  "isEnabled": true,
  "isShadowDeployed": true,
  "isBeta": true,
  "options": {
    "detectionMethod": "threshold",
    "evaluationWindow": 900,
    "keepAlive": 3600,
    "maxSignalDuration": 86400
  },
  "queries": [
    {
      "name": "automox_worklet_group_association",
      "query": "source:automox @ocsf.class_uid:3004 @ocsf.message:\"Policies Associated to Group\" @ocsf.entity.data.policy_type_name:(custom OR required_software) @ocsf.entity.data.server_count:>=25",
      "groupByFields": [
        "@ocsf.entity.uid"
      ],
      "distinctFields": [],
      "aggregation": "count"
    }
  ],
  "cases": [
    {
      "name": "",
      "status": "Medium",
      "notifications": [],
      "condition": "automox_worklet_group_association > 0"
    }
  ]
}
