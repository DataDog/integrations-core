{
  "name": "Automox remote-control consent removed on many devices",
  "product": [
    "security_monitoring"
  ],
  "defaultRuleId": "def-000-crm",
  "tags": [
    "source:automox",
    "security:attack",
    "tactic:TA0005-defense-evasion",
    "technique:T1562-impair-defenses",
    "mitre_platform:windows",
    "mitre_platform:macos",
    "mitre_platform:linux"
  ],
  "isEnabled": true,
  "isShadowDeployed": true,
  "isBeta": true,
  "options": {
    "detectionMethod": "threshold",
    "evaluationWindow": 900,
    "keepAlive": 3600,
    "maxSignalDuration": 86400
  },
  "queries": [
    {
      "name": "automox_bulk_consent_removed",
      "query": "source:automox @ocsf.class_uid:6001 @ocsf.message:\"Splashtop Bulk Remote Control Consent Changed\" (@ocsf.unmapped.new_consent_required:false OR @ocsf.unmapped.new_access_type:(unattended OR attended_allow_on_timeout))",
      "groupByFields": [
        "@ocsf.web_resources.uid"
      ],
      "distinctFields": [],
      "aggregation": "count"
    }
  ],
  "cases": [
    {
      "name": "",
      "status": "High",
      "notifications": [],
      "condition": "automox_bulk_consent_removed > 0"
    }
  ]
}
