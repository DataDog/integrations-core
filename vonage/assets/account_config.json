{
  "supported_auth_methods": [
    {
      "auth_name": "Account ID and client secret",
      "basic": {
        "user_setting": {
          "key": "account_id",
          "label": "Account ID",
          "editable": true,
          "required": true,
          "text": {}
        },
        "password_setting": {
          "key": "client_secret",
          "label": "Client secret",
          "editable": true,
          "required": true,
          "password": {}
        }
      }
    }
  ],
  "supported_connection_methods": [
    {
      "name": "Vonage",
      "fixed": {
        "fixed_base_url": "https://api.nexmo.com"
      }
    }
  ],
  "additional_config_fields": [
    {
      "key": "include_message",
      "label": "Include body of the messages in logs",
      "editable": true,
      "checkbox": {
        "default": false
      }
    }
  ],
  "dataflow_config": [
    {
      "dataflow_id": "vonage-logs"
    }
  ],
  "health_probe": {
    "http_method": "GET",
    "path": "/beta/audit/events?limit=1",
    "http_headers": [
      {
        "name": "Accept",
        "value": "application/json"
      }
    ]
  }
}
