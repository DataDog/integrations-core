{
  "supported_auth_methods": [
    {
      "auth_name": "Access key and secret key",
      "basic": {
        "user_setting": {
          "key": "access_key",
          "label": "Access key",
          "editable": true,
          "required": true,
          "text": {}
        },
        "password_setting": {
          "key": "secret_key",
          "label": "Secret key",
          "editable": true,
          "required": true,
          "password": {}
        }
      }
    }
  ],
  "supported_connection_methods": [
    {
      "name": "Tenable.io",
      "fixed": {
        "fixed_base_url": "https://cloud.tenable.com"
      }
    }
  ],
  "additional_config_fields": [],
  "dataflow_config": [
    {
      "dataflow_id": "tenable-io-activity-logs",
      "toggle": {
        "default": true,
        "label": "Collect activity logs",
        "help": "Collects Tenable.io activity logs.",
        "editable": true
      },
      "legacy_flat_mapping": {
        "enable_field": "collect_activity",
        "should_map_legacy_fields": true
      }
    },
    {
      "dataflow_id": "tenable-io-vulnerability-logs",
      "toggle": {
        "default": true,
        "label": "Collect vulnerability logs",
        "help": "Collects Tenable.io vulnerability logs.",
        "editable": true
      },
      "legacy_flat_mapping": {
        "enable_field": "collect_vulnerability",
        "should_map_legacy_fields": true
      }
    }
  ],
  "health_probe": {
    "http_method": "GET",
    "path": "/audit-log/v1/events?limit=1",
    "http_headers": [
      {
        "name": "Accept",
        "value": "application/json"
      }
    ]
  }
}
