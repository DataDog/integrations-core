    { "id": 6000, "definition": { "title": "Interoperability", "show_title": true, "type": "group", "layout_type": "ordered", "widgets": [
  {
    "id": 6001,
    "definition": {
      "title": "Business hosts — status, staleness, message counts (per interop_host)",
      "title_size": "16", "title_align": "left", "type": "query_table",
      "requests": [
        { "response_format": "scalar", "aggregator": "last",
