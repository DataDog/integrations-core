            { "data_source": "metrics", "name": "status", "query": "max:intersystems_iris.interop.hosts{$env,$host,$production,$interop_host} by {interop_host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "idle", "query": "max:intersystems_iris.interop.last_activity{$env,$host,$production,$interop_host} by {interop_host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "count", "query": "sum:intersystems_iris.interop.messages.count{$env,$host,$production,$interop_host} by {interop_host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "errored", "query": "sum:intersystems_iris.interop.messages.errored{$env,$host,$production,$interop_host} by {interop_host}", "aggregator": "last" }
          ],
          "formulas": [
            { "alias": "Status", "formula": "status" },
            { "alias": "Seconds since last activity", "formula": "idle" },
