    { "id": 4000, "definition": { "title": "Mirror (high availability)", "show_title": true, "type": "group", "layout_type": "ordered", "widgets": [
  {
    "id": 4001,
    "definition": {
      "title": "Mirror members — role, sync status, readiness (per host)",
      "title_size": "16", "title_align": "left", "type": "query_table",
      "requests": [
        { "response_format": "scalar", "aggregator": "last",
          "queries": [
            { "data_source": "metrics", "name": "role", "query": "max:intersystems_iris.mirror.member_type{$env,$host} by {host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "status", "query": "max:intersystems_iris.mirror.status{$env,$host} by {host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "ready", "query": "max:intersystems_iris.mirror.failover_ready{$env,$host} by {host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "nofail", "query": "max:intersystems_iris.mirror.no_failover{$env,$host} by {host}", "aggregator": "last" },
            { "data_source": "metrics", "name": "missing", "query": "max:intersystems_iris.mirror.missing_databases{$env,$host} by {host}", "aggregator": "last" }
          ],
          "formulas": [
            { "alias": "Role (2=primary)", "formula": "role" },
            { "alias": "Status (2 Pri/3 Bkp/5 Trans/8 Stop/9 Crash)", "formula": "status",
              "conditional_formats": [
                { "comparator": ">=", "value": 8, "palette": "white_on_red" },
                { "comparator": ">=", "value": 5, "palette": "white_on_yellow" },
                { "comparator": "<", "value": 5, "palette": "white_on_green" } ] },
            { "alias": "Failover ready", "formula": "ready" },
            { "alias": "No failover", "formula": "nofail" },
            { "alias": "Missing DBs", "formula": "missing",
              "conditional_formats": [ { "comparator": ">", "value": 0, "palette": "white_on_red" } ] }
          ] }
      ],
      "has_search_bar": "auto"
    },
    "layout": { "x": 0, "y": 0, "width": 12, "height": 3 }
