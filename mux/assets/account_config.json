{
  "supported_auth_methods": [
    {
      "auth_name": "Access Token ID and Secret Key",
      "basic": {
        "user_setting": {
          "key": "access_token_id",
          "label": "Access token ID",
          "editable": true,
          "required": true,
          "text": {}
        },
        "password_setting": {
          "key": "secret_key",
          "label": "Secret key",
          "editable": true,
          "required": true,
          "password": {}
        }
      }
    }
  ],
  "supported_connection_methods": [
    {
      "name": "Mux",
      "fixed": {
        "fixed_base_url": "https://api.mux.com"
      }
    }
  ],
  "dataflow_config": [
    {
      "dataflow_id": "mux-metrics"
    }
  ],
  "health_probe": {
    "http_method": "GET",
    "path": "/data/v1/metrics",
    "http_headers": [
      {
        "name": "Accept",
        "value": "application/json"
      }
    ]
  }
}
